# Cấu hình đóng gói MSIX cho Microsoft Store
# Lấy các giá trị này từ Partner Center -> Product management -> App identity

# Bật đóng gói MSIX (yêu cầu Windows 10/11 SDK trên máy)
OPTB_BUILD_MSIX=1

# Package/Identity/Name (ví dụ: 12345MyName.OfflinePDFToolbox)
MSIX_IDENTITY_NAME=

# Package/Identity/Publisher (ví dụ: CN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX)
MSIX_PUBLISHER=

# Package/Properties/PublisherDisplayName (ví dụ: Your Name or Company)
MSIX_PUBLISHER_DISPLAY_NAME=
