# Cấu hình đóng gói MSIX cho Microsoft Store
# Lấy các giá trị này từ Partner Center -> Product management -> Product identity

# Bật đóng gói MSIX (yêu cầu Windows 10/11 SDK trên máy)
OPTB_BUILD_MSIX=1

# Package/Identity/Name
MSIX_IDENTITY_NAME=MTDStudio.OfflinePDFToolbox

# Package/Identity/Publisher
MSIX_PUBLISHER=CN=F6CFEAEE-C755-4C7E-BDC5-FD89DA169656

# Package/Properties/PublisherDisplayName
MSIX_PUBLISHER_DISPLAY_NAME=MTD Studio
